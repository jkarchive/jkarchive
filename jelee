<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>이지은 | LEE JI EUN — 이력서</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet"/>
  <style>
    :root{
      --navy:#0d1f35; --navy-mid:#162d47;
      --teal:#1a8b78; --teal-light:#25bfa8; --teal-pale:#e6f5f3;
      --ivory:#f9f8f5; --white:#fff;
      --text:#1c1c2e; --muted:#6b7b8d;
      --border:#dce8e5; --border-soft:#edf2f1;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;font-weight:300;background:var(--ivory);color:var(--text);line-height:1.75;overflow-x:hidden}

    /* ── LIGHTBOX ─────────────────────────────────────── */
    .lb-overlay{
      display:none;position:fixed;inset:0;background:rgba(0,0,0,.9);
      z-index:9999;align-items:center;justify-content:center;padding:20px;
      cursor:zoom-out;
    }
    .lb-overlay.active{display:flex}
    .lb-box{position:relative;max-width:92vw;max-height:92vh;cursor:default}
    .lb-box img{max-width:100%;max-height:88vh;border-radius:8px;box-shadow:0 0 60px rgba(0,0,0,.6);display:block}
    .lb-close{
      position:absolute;top:-38px;right:0;
      background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.4);
      color:#fff;font-size:1.1rem;width:30px;height:30px;border-radius:50%;
      cursor:pointer;display:flex;align-items:center;justify-content:center;
      transition:background .2s;
    }
    .lb-close:hover{background:rgba(255,255,255,.3)}

    /* ── HEADER ───────────────────────────────────────── */
    header{background:var(--navy);color:#fff;padding:60px 40px 48px;position:relative;overflow:hidden}
    header::before{
      content:'';position:absolute;top:-120px;right:-120px;
      width:480px;height:480px;border-radius:50%;
      background:radial-gradient(circle,rgba(26,139,120,.18) 0%,transparent 65%);
      pointer-events:none
    }
    header::after{
      content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
      background:linear-gradient(90deg,var(--teal),var(--teal-light) 50%,transparent)
    }
    .header-inner{max-width:860px;margin:0 auto;display:grid;grid-template-columns:auto 1fr auto;gap:28px;align-items:flex-start}

    /* Profile photo */
    .profile-photo{
      width:150px;height:150px;border-radius:50%;
      border:2.5px solid var(--teal-light);
      object-fit:cover;object-position:center 18%;
      flex-shrink:0;
      box-shadow:0 0 0 5px rgba(37,191,168,.15);
      cursor:zoom-in;
      transition:box-shadow .2s,transform .2s;
    }
    .profile-photo:hover{box-shadow:0 0 0 7px rgba(37,191,168,.25);transform:scale(1.02)}

    .hero-name{font-family:'DM Sans',sans-serif;font-weight:300;font-size:clamp(2.2rem,6vw,3.4rem);line-height:1.05;letter-spacing:.02em}
    .hero-name em{display:block;font-style:normal;font-weight:400;font-size:clamp(.72rem,2vw,.85rem);letter-spacing:.3em;text-transform:uppercase;color:var(--teal-light);margin-top:7px}
    .hero-sub{margin-top:12px;font-size:.86rem;color:rgba(255,255,255,.6);line-height:1.8}
    .hero-sub strong{color:rgba(255,255,255,.88);font-weight:500}
    .hero-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
    .hero-tag{background:rgba(37,191,168,.15);border:1px solid rgba(37,191,168,.3);color:var(--teal-light);font-size:.72rem;font-weight:500;letter-spacing:.06em;padding:3px 10px;border-radius:20px}

    .contact-list{display:flex;flex-direction:column;gap:10px;margin-top:4px}
    .contact-item{display:flex;align-items:center;gap:8px;font-size:.81rem;color:rgba(255,255,255,.65);justify-content:flex-end}
    .contact-item a{color:rgba(255,255,255,.65);text-decoration:none;transition:color .2s}
    .contact-item a:hover{color:var(--teal-light)}
    .ci-icon{width:15px;height:15px;fill:var(--teal-light);flex-shrink:0}

    /* ── MAIN ─────────────────────────────────────────── */
    main{max-width:860px;margin:0 auto;padding:64px 40px 80px}

    /* ── SECTION ─────────────────────────────────────── */
    .section{margin-bottom:56px}
    .section-head{display:flex;align-items:center;gap:14px;margin-bottom:28px}
    .section-head h2{font-family:'DM Sans',sans-serif;font-weight:600;font-size:1.05rem;color:var(--navy);white-space:nowrap;letter-spacing:.08em;text-transform:uppercase}
    .sh-line{flex:1;height:1px;background:linear-gradient(90deg,var(--teal) 0%,transparent 100%)}

    /* ── TIMELINE ─────────────────────────────────────── */
    .timeline-item{display:grid;grid-template-columns:160px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--border-soft)}
    .timeline-item:first-child{padding-top:4px}
    .timeline-item:last-child{border-bottom:none}
    .t-date{font-size:.78rem;color:var(--teal);font-weight:400;letter-spacing:.04em;padding-top:3px;line-height:1.6}
    .t-body h3{font-size:.95rem;font-weight:500;color:var(--navy);margin-bottom:3px}
    .t-body p{font-size:.82rem;color:var(--muted);line-height:1.6}
    .badge{display:inline-block;background:var(--teal-pale);color:var(--teal);font-size:.71rem;font-weight:500;padding:2px 9px;border-radius:4px;margin-top:7px;letter-spacing:.03em}

    /* ── SKILLS ─────────────────────────────────────────── */
    .skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .skill-card{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:20px;transition:border-color .2s,transform .2s,box-shadow .2s}
    .skill-card:hover{border-color:var(--teal);transform:translateY(-2px);box-shadow:0 6px 20px rgba(26,139,120,.08)}
    .skill-card h3{font-size:1rem;font-weight:700;color:var(--navy);letter-spacing:.04em;margin-bottom:5px}
    .sk-desc{font-size:.74rem;color:var(--muted);line-height:1.5}
    .skill-bar{margin-top:12px;height:3px;background:var(--border);border-radius:3px;overflow:hidden}
    .skill-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--teal-light));border-radius:3px;animation:barGrow .9s ease both}
    .sk-level{margin-top:7px;font-size:.72rem;color:var(--teal);font-weight:500}
    @keyframes barGrow{from{width:0!important}}

    /* ── PAPERS ─────────────────────────────────────────── */
    .paper-item{padding:18px 22px;background:var(--white);border-left:3px solid var(--teal);border-radius:0 8px 8px 0;margin-bottom:14px;box-shadow:0 1px 4px rgba(0,0,0,.04);transition:border-left-width .2s,padding-left .2s,box-shadow .2s}
    .paper-item:last-child{margin-bottom:0}
    .paper-item:hover{border-left-width:5px;padding-left:20px;box-shadow:0 4px 12px rgba(26,139,120,.1)}
    .paper-item h3{font-size:.9rem;font-weight:400;font-style:italic;color:var(--navy);line-height:1.6;margin-bottom:8px;overflow-wrap:break-word}
    .paper-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .paper-date{font-size:.74rem;color:var(--teal);font-weight:500}
    .paper-link{display:inline-flex;align-items:center;gap:5px;font-size:.72rem;color:var(--teal);font-weight:500;text-decoration:none;padding:2px 9px;border:1px solid var(--teal);border-radius:4px;transition:background .2s,color .2s}
    .paper-link:hover{background:var(--teal);color:#fff}
    .paper-link svg{width:11px;height:11px;fill:currentColor;flex-shrink:0}

    /* ── PROJECTS ─────────────────────────────────────── */
    .project-list{display:flex;flex-direction:column;gap:12px}
    .proj-card{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:18px 22px;display:grid;grid-template-columns:auto 1fr auto;column-gap:14px;row-gap:6px;align-items:start;transition:box-shadow .2s}
    .proj-card:hover{box-shadow:0 4px 18px rgba(26,139,120,.09)}
    .proj-org{display:inline-flex;align-items:center;background:var(--teal-pale);color:var(--teal);font-size:.71rem;font-weight:500;padding:3px 10px;border-radius:5px;white-space:nowrap;height:fit-content;margin-top:1px}
    .proj-body{min-width:0}
    .proj-title{font-size:.86rem;color:var(--text);line-height:1.65;overflow-wrap:break-word;word-break:break-word}
    .proj-period{font-size:.73rem;color:var(--muted);margin-top:3px}
    .proj-actions{display:flex;flex-direction:column;gap:5px;align-items:flex-end}
    .proj-role{display:inline-flex;align-items:center;background:var(--teal);color:#fff;font-size:.7rem;font-weight:500;padding:2px 9px;border-radius:4px;white-space:nowrap}
    .proj-link{display:inline-flex;align-items:center;gap:4px;font-size:.7rem;color:var(--teal);font-weight:500;text-decoration:none;padding:2px 8px;border:1px solid var(--teal);border-radius:4px;white-space:nowrap;transition:background .2s,color .2s}
    .proj-link:hover{background:var(--teal);color:#fff}
    .proj-link svg{width:10px;height:10px;fill:currentColor;flex-shrink:0}

    /* ── AWARD ─────────────────────────────────────────── */
    .award-card{background:linear-gradient(135deg,var(--teal-pale) 0%,var(--white) 60%);border:1px solid var(--border);border-radius:10px;padding:22px 24px;display:flex;align-items:center;gap:18px}
    .award-icon-wrap{width:46px;height:46px;background:var(--teal);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .award-icon-wrap svg{width:22px;height:22px;fill:#fff}
    .award-text h3{font-size:.95rem;font-weight:500;color:var(--navy)}
    .award-text p{font-size:.8rem;color:var(--muted);margin-top:2px}

    /* ── CERTS & LANGUAGE (merged) ────────────────────── */
    .cert-lang-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
    .cert-card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:14px 16px}
    .cert-card h3{font-size:.88rem;font-weight:500;color:var(--navy)}
    .cert-card p{font-size:.75rem;color:var(--muted);margin-top:2px;line-height:1.5}
    .cert-card.lang-card{border-color:var(--teal);background:linear-gradient(135deg,var(--teal-pale) 0%,var(--white) 80%)}
    .lang-badge-inline{display:inline-block;background:var(--navy);color:#fff;font-size:.85rem;font-weight:700;padding:3px 8px;border-radius:5px;letter-spacing:.05em;margin-bottom:4px}

    /* ── ACTIVITIES ───────────────────────────────────── */
    .act-grid{display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start}
    .act-conf-card{border-radius:12px;overflow:hidden;background:var(--white);border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,.06);cursor:zoom-in;transition:box-shadow .2s}
    .act-conf-card:hover{box-shadow:0 6px 24px rgba(0,0,0,.12)}
    .act-conf-img{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:center 10%;display:block}
    .act-conf-caption{padding:12px 14px}
    .act-conf-caption .act-badge{display:inline-block;background:var(--teal);color:#fff;font-size:.7rem;font-weight:600;padding:2px 8px;border-radius:4px;letter-spacing:.06em;margin-bottom:5px}
    .act-conf-caption p{font-size:.78rem;color:var(--muted);line-height:1.5}

    .poster-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    .poster-card{background:var(--white);border:1px solid var(--border);border-radius:10px;overflow:hidden;cursor:zoom-in;transition:box-shadow .2s,transform .2s}
    .poster-card:hover{box-shadow:0 6px 20px rgba(26,139,120,.12);transform:translateY(-2px)}
    .poster-thumb{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:top;display:block}
    .poster-info{padding:10px 12px}
    .poster-info p{font-size:.73rem;color:var(--text);line-height:1.5;overflow-wrap:break-word;word-break:break-word}

    /* ── FOOTER ─────────────────────────────────────────── */
    footer{background:var(--navy);color:rgba(255,255,255,.4);text-align:center;padding:28px 20px;font-size:.78rem;letter-spacing:.05em}

    /* ── FADE-IN ─────────────────────────────────────────── */
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .section{animation:fadeUp .55s ease both}
    .section:nth-child(2){animation-delay:.05s}.section:nth-child(3){animation-delay:.10s}
    .section:nth-child(4){animation-delay:.15s}.section:nth-child(5){animation-delay:.20s}
    .section:nth-child(6){animation-delay:.25s}.section:nth-child(7){animation-delay:.30s}

    /* ── RESPONSIVE ─────────────────────────────────────── */
    @media(max-width:700px){
      header{padding:44px 20px 38px}
      .header-inner{grid-template-columns:1fr;gap:0}
      .profile-photo{display:block;margin:0 auto 18px;width:120px;height:120px}
      .hero-name{text-align:center;font-size:2.2rem}
      .hero-name em{text-align:center}
      .hero-sub{text-align:center}
      .hero-tags{justify-content:center}
      .contact-list{align-items:flex-start;margin-top:20px}
      .contact-item{justify-content:flex-start}
      main{padding:44px 18px 60px}
      .timeline-item{grid-template-columns:1fr;gap:4px}
      .t-date{padding-top:0}
      .skills-grid{grid-template-columns:1fr}
      .proj-card{grid-template-columns:1fr;grid-template-rows:auto auto auto}
      .proj-actions{flex-direction:row;align-items:center;flex-wrap:wrap}
      .act-grid{grid-template-columns:1fr}
      .act-conf-img{aspect-ratio:4/3}
      .poster-grid{grid-template-columns:1fr}
      .cert-lang-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:400px){
      .cert-lang-grid{grid-template-columns:1fr}
      .poster-grid{grid-template-columns:1fr}
    }
  </style>
</head>
